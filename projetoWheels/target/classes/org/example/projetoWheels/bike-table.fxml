<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.BikeTableController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <TableView fx:id="tableView" editable="true">
        <columns>
            <TableColumn fx:id="colBikeId" text="id"/>
            <TableColumn fx:id="colBikeType" text="tipo"/>
            <TableColumn fx:id="colBikeBrand" text="marca"/>
            <TableColumn fx:id="colBikeModel" text="modelo"/>
            <TableColumn fx:id="colRentalPrice" text="custo diária"/>
            <TableColumn fx:id="colDepositPrice" text="depósito"/>
            <TableColumn fx:id="colIsAvailable" text="disponível"/>
        </columns>
    </TableView>

    <Button text="salvar alterações" styleClass="botao" onAction="#handleSalvarAlteracoes"/>

</VBox>
