<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.CustomerController"
      spacing="15"
      stylesheets="@styles.css"
      styleClass="customer"
      prefWidth="400" prefHeight="400">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="cadastro de cliente" styleClass="title"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <TextField fx:id="customerNameField" promptText="nome" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <TextField fx:id="customerAddressField" promptText="endereço" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <TextField fx:id="customerTelephoneNumberField" promptText="telefone" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <CheckBox fx:id="isSeniorCheck" text="idoso(a)" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <CheckBox fx:id="isStudentCheck" text="estudante" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <Button text="salvar" styleClass="botao" onAction="#handleSalvar"/>

</VBox>
