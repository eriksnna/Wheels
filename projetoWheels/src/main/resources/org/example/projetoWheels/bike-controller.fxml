<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.BikeController"
      spacing="15"
      stylesheets="@styles.css"
      styleClass="bike"
      prefWidth="400"
      prefHeight="400">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="cadastro de bicicletas" styleClass="title"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <TextField fx:id="bikeTypeField" promptText="tipo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <TextField fx:id="bikeBrandField" promptText="marca" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <TextField fx:id="bikeModelField" promptText="modelo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <TextField fx:id="rentalPriceField" promptText="preço diária" GridPane.columnIndex="1" GridPane.rowIndex="3" onKeyReleased="#atualizarDeposito"/>

        <TextField fx:id="depositPriceField" promptText="depósito" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <Button text="salvar" styleClass="botao" onAction="#handleSalvar"/>

</VBox>
